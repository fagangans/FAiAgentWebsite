PORT=3001

# Set true untuk testing internal tanpa API key asli (Step 6)
USE_MOCK_AI=true

# Diisi saat Step 7 - jangan commit file .env yang sudah terisi ke git
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Opsional, default sudah model paling hemat token (2.5 Flash-Lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# Token untuk endpoint /api/admin/sites (dipakai daftarkan website klien baru)
ADMIN_TOKEN=
