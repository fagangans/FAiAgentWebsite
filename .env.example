# Gemini API key dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opsional: ganti model Gemini (default: gemini-2.5-flash-lite, paling hemat token)
# GEMINI_MODEL=gemini-2.5-flash-lite

# Opsional: system prompt untuk personality bot AI di WhatsApp
# BOT_SYSTEM_PROMPT=Kamu adalah asisten AI yang ramah dan membantu. Jawab dalam Bahasa Indonesia kecuali diminta bahasa lain.
